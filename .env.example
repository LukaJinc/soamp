# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.

# wandb API key -- required when config/train/*.yaml's tracking.backend is
# "wandb". Get yours at https://wandb.ai/authorize
WANDB_API_KEY=

# wandb entity (user or team) to log runs under. Optional -- omit to use
# your default entity.
WANDB_ENTITY=